<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingVertical="12dp">

        <!-- Time + days info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScheduleTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:00 → 07:00"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvScheduleDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mo Tu We Th Fr"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOutline"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvAutoRestart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↺ Auto-restart ON"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Enable toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp" />

        <!-- Delete button — styled as error/destructive -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="20dp"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorError"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="20dp"
            app:strokeColor="?attr/colorErrorContainer"
            app:strokeWidth="1dp"
            android:backgroundTint="?attr/colorErrorContainer"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
