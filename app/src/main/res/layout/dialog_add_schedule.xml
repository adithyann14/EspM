<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Time pickers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickStart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="06:00"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:cornerRadius="8dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  →  "
            android:textSize="18sp"
            android:textColor="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="07:00"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:cornerRadius="8dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Day checkboxes -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REPEAT ON"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSun" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Su" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbMon" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Mo" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTue" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Tu" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbWed" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="We" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbThu" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Th" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbFri" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Fr" android:checked="true" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSat" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Sa" android:checked="true" />
    </LinearLayout>

    <!-- Auto-restart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto-restart after power cut"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSchedAutoRestart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>
</LinearLayout>
